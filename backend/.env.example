DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5433/DB_NAME
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGINS=

LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_CHAT_MODEL=qwen3:14b
LLM_EMBEDDING_MODEL=qwen3-embedding-cpu
LLM_EMBEDDING_DIMENSIONS=1024
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=700
LLM_TEMPERATURE=0.7
# Для Qwen3 отключает рассуждения; для других моделей оставьте пустым
LLM_SYSTEM_SUFFIX=/no_think

RETRIEVAL_TOP_K=4
RECENT_MESSAGE_LIMIT=12
MAX_MESSAGE_LENGTH=4000
CHAT_RATE_LIMIT_PER_MINUTE=30
